{
  "name": "trip-management-api",
  "version": "1.0.0",
  "description": "Trip Management REST API (Node.js + Express + PostgreSQL + Prisma)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.0.0"
  }
}
